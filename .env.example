# Database Configuration
REGISTRY_DB_URL=postgresql://arvi:password@localhost:5432/arvi_healthlink_registry
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=arvi
TENANT_DB_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here-change-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=1

# HealthLink Configuration
HEALTHLINK_BASE_DIR=/opt/healthlink
ARVI_CENTRAL_EDI=ARVIHLT1

# Worker Configuration
POLL_INTERVAL_SECONDS=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_TO_DATABASE=true

# Application Configuration
APP_NAME=ARVI HealthLink Integration
APP_VERSION=1.0.0
DEBUG=false
